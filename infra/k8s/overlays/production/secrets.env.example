# Template only -- copy to `secrets.env` (gitignored, never committed) in
# this same directory and fill in real values before deploying. Every key
# here matches base/config.yaml's Secret one-for-one (see that file's own
# comment for why: each name is a Settings field env var).
#
# `secrets.env` is consumed by this overlay's kustomization.yaml via a
# `secretGenerator` with `behavior: replace` -- it REPLACES base/config.yaml's
# placeholder Secret entirely at render time (base/config.yaml itself is
# never edited). If `secrets.env` does not exist, `kubectl kustomize` /
# `kubectl apply -k` on this overlay will fail with a clear "file not found"
# error rather than silently deploying with REPLACE_ME_* placeholders --
# a deliberate fail-closed default (SEC-004).
#
# Prefer NOT using this file at all in a real production pipeline -- an
# External Secrets Operator ExternalSecret/SecretStore pulling from a real
# secrets manager (AWS Secrets Manager, GCP Secret Manager, Vault, etc.) is
# the more production-grade pattern this repo does not commit to any one
# choice of, since that choice is cluster/cloud-specific. If using ESO (or
# Sealed Secrets, or a CI/CD-injected `kubectl create secret`), delete the
# `secretGenerator` block from kustomization.yaml entirely and let that
# external mechanism own the `testpilot-secrets` Secret instead -- as long
# as something in the cluster produces a Secret named `testpilot-secrets`
# with these same keys before the Deployments start, either approach works.

# postgresql+asyncpg://testpilot_app:<password>@<host>:5432/<db> -- the
# least-privilege runtime role (RLS only applies to a non-superuser,
# non-table-owner connection -- see the rls_role_and_policies migration).
# Real value: your managed Postgres instance (e.g. RDS/Cloud SQL), not a
# Deployment this repo runs (see infra/k8s/README.md's "What's deliberately
# NOT here").
DATABASE_URL=REPLACE_ME_DATABASE_URL

# Needs DDL/role-management privileges DATABASE_URL's role deliberately
# does not have -- used only by the entrypoint's `alembic upgrade head`.
MIGRATIONS_DATABASE_URL=REPLACE_ME_MIGRATIONS_DATABASE_URL

# Real value: your managed Redis instance (e.g. ElastiCache), not a
# Deployment this repo runs.
REDIS_URL=REPLACE_ME_REDIS_URL

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=REPLACE_ME_JWT_SIGNING_KEY_MIN_32_CHARS

AI_PROVIDER_API_KEY=REPLACE_ME_AI_PROVIDER_API_KEY

# --- Object storage: the presigned-URL public-hostname problem ---
# docs/RELEASE.md's "Known gap" and quickstart-results.md's Section 1/2
# notes document this exactly: storage/s3.py signs URLs using this same
# OBJECT_STORAGE_ENDPOINT_URL, and that signed URL is handed directly to a
# browser. If this value is a cluster-internal hostname (e.g.
# `http://minio.storage.svc.cluster.local:9000`), screenshot/artifact
# viewing will be broken for every real user outside the cluster network --
# this MUST be a publicly-reachable S3/MinIO-compatible endpoint (a real S3
# bucket's regional endpoint, or a MinIO/other S3-compatible store sitting
# behind a public reverse proxy/CDN with the same DNS name used for
# signing). This overlay does not invent a value for you -- there is no
# single correct answer independent of which object-storage provider you
# actually use.
OBJECT_STORAGE_ENDPOINT_URL=REPLACE_ME_PUBLIC_OBJECT_STORAGE_ENDPOINT_URL
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME_OBJECT_STORAGE_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME_OBJECT_STORAGE_SECRET_KEY

# Optional -- leave empty to disable (core/observability.py's init_sentry
# is a no-op with no DSN configured, per base/config.yaml's own comment).
SENTRY_DSN=

# Optional -- leave empty to fall back to log-only email delivery
# (core/email.py: `if settings.smtp_host is None: return`, after logging).
SMTP_HOST=REPLACE_ME_SMTP_HOST

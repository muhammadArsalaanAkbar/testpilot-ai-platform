# Example only -- NOT wired into kustomization.yaml's `resources:` list,
# and NOT applied by `kubectl apply -k infra/k8s/overlays/production/` as
# the overlay ships. This is Option B, an alternative to Option A (the
# `secretGenerator` + `secrets.env` already in kustomization.yaml) -- see
# infra/k8s/README.md's "External Secrets Operator (alternative)" section
# for the full explanation and switch-over steps. Using this file requires
# BOTH:
#   1. The External Secrets Operator (https://external-secrets.io) already
#      installed in the target cluster -- this repo does not install it,
#      configure it, or assume it exists.
#   2. A real SecretStore/ClusterSecretStore already created in that
#      cluster, pointed at whatever real secrets manager you use (AWS
#      Secrets Manager, GCP Secret Manager, Azure Key Vault, Vault, etc.)
#      -- `REPLACE_ME_SECRET_STORE_NAME` below is a placeholder name, not
#      a real one; this repo does not commit to or assume any one provider
#      (deliberately provider-neutral, matching secrets.env.example's own
#      "this repo does not commit to any one choice" language).
#
# To actually use this option: rename/copy this file to
# `external-secret.yaml` (dropping `.example`), add it to
# kustomization.yaml's `resources:` list, and DELETE the
# `secretGenerator:` block from kustomization.yaml -- see requirement #5's
# "only one should be enabled" in the commit this file was added by.
# Applying both at once is undefined: Kustomize's `secretGenerator` and
# this `ExternalSecret`'s controller would both try to own a Secret named
# `testpilot-secrets`, and whichever reconciles/applies last wins,
# non-deterministically.
#
# Every `remoteRef.key` value below is illustrative (a plausible path
# shape, not a real secret's location in any real secrets manager) --
# replace with wherever your chosen provider actually stores each value.
# The `secretKey` on the left (the key inside the K8s Secret this produces)
# is NOT illustrative -- it must match base/config.yaml's Secret keys
# exactly, the same ones secrets.env.example already documents, since
# testpilot.api.main / testpilot.worker.main read Settings fields from
# these exact env var names via `envFrom: secretRef: name: testpilot-secrets`
# in base/deployments.yaml (unchanged by which option produces the Secret).

apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: testpilot-secrets
spec:
  refreshInterval: 1h
  secretStoreRef:
    # SecretStore = namespace-scoped (one per namespace/environment);
    # ClusterSecretStore = cluster-wide, reusable across namespaces. Either
    # works here -- pick whichever your ESO installation is actually
    # configured with. Swap `kind: SecretStore` for `kind: ClusterSecretStore`
    # if using the latter.
    kind: SecretStore
    # Placeholder, but must still be a valid Kubernetes resource name
    # (lowercase alphanumeric + hyphens -- it references another
    # resource's metadata.name) -- replace with your real SecretStore's
    # actual name, not literally this string.
    name: replace-me-secret-store-name
  target:
    # Same name base/config.yaml's Secret and Option A's secretGenerator
    # both use -- base/deployments.yaml's `secretRef: name: testpilot-secrets`
    # needs no change no matter which of the two options produces it.
    name: testpilot-secrets
    creationPolicy: Owner
  data:
    # postgresql+asyncpg://testpilot_app:<password>@<host>:5432/<db> -- see
    # secrets.env.example's own comment on this key for the full
    # least-privilege-role explanation.
    - secretKey: DATABASE_URL
      remoteRef:
        key: testpilot/production/database-url
    # Needs DDL/role-management privileges DATABASE_URL's role deliberately
    # does not have -- used only by the entrypoint's `alembic upgrade head`.
    - secretKey: MIGRATIONS_DATABASE_URL
      remoteRef:
        key: testpilot/production/migrations-database-url
    - secretKey: REDIS_URL
      remoteRef:
        key: testpilot/production/redis-url
    - secretKey: JWT_SIGNING_KEY
      remoteRef:
        key: testpilot/production/jwt-signing-key
    - secretKey: AI_PROVIDER_API_KEY
      remoteRef:
        key: testpilot/production/ai-provider-api-key
    # --- Object storage: same presigned-URL public-hostname requirement
    # secrets.env.example documents -- this MUST resolve to a value the
    # remote secrets manager stores that is a genuinely publicly-reachable
    # endpoint, not a cluster-internal one. Not this file's concern to
    # enforce; documented here so the requirement travels with the key.
    - secretKey: OBJECT_STORAGE_ENDPOINT_URL
      remoteRef:
        key: testpilot/production/object-storage-endpoint-url
    - secretKey: OBJECT_STORAGE_ACCESS_KEY
      remoteRef:
        key: testpilot/production/object-storage-access-key
    - secretKey: OBJECT_STORAGE_SECRET_KEY
      remoteRef:
        key: testpilot/production/object-storage-secret-key
    # Optional in the app (core/observability.py's init_sentry is a no-op
    # with no DSN configured) -- included here so the generated Secret has
    # the same key set as Option A's, whether or not you populate it with
    # a real value in your secrets manager.
    - secretKey: SENTRY_DSN
      remoteRef:
        key: testpilot/production/sentry-dsn
    # Optional -- omit this whole `data[]` entry (not just leave the
    # remote value blank) if you don't have a transactional-email relay
    # configured for this environment; core/email.py already handles a
    # totally-absent SMTP_HOST by falling back to log-only delivery.
    - secretKey: SMTP_HOST
      remoteRef:
        key: testpilot/production/smtp-host

# --- Alternative shape: dataFrom (not used above, illustrative only) ---
# If your secrets manager already stores all of these as one JSON object
# at a single path (rather than one entry per key), `dataFrom` pulls the
# whole thing and maps top-level JSON keys to Secret keys automatically,
# instead of listing each key under `data:` individually:
#
#   dataFrom:
#     - extract:
#         key: testpilot/production/all-secrets
#
# Whichever shape you use, the resulting Secret's keys must still match
# base/config.yaml's exactly for testpilot to read them.

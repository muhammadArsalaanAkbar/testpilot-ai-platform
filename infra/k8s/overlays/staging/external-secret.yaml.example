# Example only -- NOT wired into kustomization.yaml's `resources:` list,
# and NOT applied by `kubectl apply -k infra/k8s/overlays/staging/` as
# the overlay ships. This is Option B, an alternative to Option A (the
# `secretGenerator` + `secrets.env` already in kustomization.yaml) -- see
# infra/k8s/README.md's "External Secrets Operator (alternative)" section
# for the full explanation and switch-over steps (identical mechanism to
# overlays/production/external-secret.yaml.example, just pointed at
# staging's own SecretStore/remote paths below). Using this file requires
# BOTH:
#   1. The External Secrets Operator (https://external-secrets.io) already
#      installed in the target cluster -- this repo does not install it,
#      configure it, or assume it exists.
#   2. A real SecretStore/ClusterSecretStore already created in that
#      cluster, pointed at whatever real secrets manager you use (AWS
#      Secrets Manager, GCP Secret Manager, Azure Key Vault, Vault, etc.)
#      -- `replace-me-staging-secret-store-name` below is a placeholder
#      name, not a real one; this repo does not commit to or assume any
#      one provider.
#
# To actually use this option: rename/copy this file to
# `external-secret.yaml` (dropping `.example`), add it to
# kustomization.yaml's `resources:` list, and DELETE the
# `secretGenerator:` block from kustomization.yaml. Applying both at once
# is undefined: Kustomize's `secretGenerator` and this `ExternalSecret`'s
# controller would both try to own a Secret named `testpilot-secrets`
# (within the testpilot-staging namespace -- distinct from production's
# own testpilot-secrets in testpilot-production, so no cross-environment
# collision either way), and whichever reconciles/applies last wins,
# non-deterministically.
#
# Every `remoteRef.key` value below is illustrative (a plausible path
# shape, not a real secret's location in any real secrets manager) --
# deliberately under a `testpilot/staging/...` prefix, DIFFERENT from
# overlays/production/external-secret.yaml.example's `testpilot/production/...`
# -- staging and production must never resolve to the same remote secret,
# or the two environments stop being isolated from each other. The
# `secretKey` on the left (the key inside the K8s Secret this produces)
# is NOT illustrative -- it must match base/config.yaml's Secret keys
# exactly, the same ones secrets.env.example already documents.

apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: testpilot-secrets
spec:
  refreshInterval: 1h
  secretStoreRef:
    # SecretStore = namespace-scoped (one per namespace/environment);
    # ClusterSecretStore = cluster-wide, reusable across namespaces.
    # Swap `kind: SecretStore` for `kind: ClusterSecretStore` if using
    # the latter. If your ESO setup uses one ClusterSecretStore shared
    # across both staging and production, this `data[].remoteRef.key`
    # prefix (`testpilot/staging/...`) is what actually keeps the two
    # environments' secret VALUES separate -- the store reference alone
    # does not.
    kind: SecretStore
    name: replace-me-staging-secret-store-name
  target:
    # Same name base/config.yaml's Secret and Option A's secretGenerator
    # both use -- base/deployments.yaml's `secretRef: name: testpilot-secrets`
    # needs no change no matter which of the two options produces it.
    # Scoped to the testpilot-staging namespace by this overlay's own
    # `namespace: testpilot-staging` in kustomization.yaml, same as every
    # other resource here.
    name: testpilot-secrets
    creationPolicy: Owner
  data:
    - secretKey: DATABASE_URL
      remoteRef:
        key: testpilot/staging/database-url
    - secretKey: MIGRATIONS_DATABASE_URL
      remoteRef:
        key: testpilot/staging/migrations-database-url
    - secretKey: REDIS_URL
      remoteRef:
        key: testpilot/staging/redis-url
    - secretKey: JWT_SIGNING_KEY
      remoteRef:
        key: testpilot/staging/jwt-signing-key
    - secretKey: AI_PROVIDER_API_KEY
      remoteRef:
        key: testpilot/staging/ai-provider-api-key
    # --- Object storage: same presigned-URL public-hostname requirement
    # secrets.env.example documents -- staging needs its OWN bucket/
    # endpoint, not production's.
    - secretKey: OBJECT_STORAGE_ENDPOINT_URL
      remoteRef:
        key: testpilot/staging/object-storage-endpoint-url
    - secretKey: OBJECT_STORAGE_ACCESS_KEY
      remoteRef:
        key: testpilot/staging/object-storage-access-key
    - secretKey: OBJECT_STORAGE_SECRET_KEY
      remoteRef:
        key: testpilot/staging/object-storage-secret-key
    - secretKey: SENTRY_DSN
      remoteRef:
        key: testpilot/staging/sentry-dsn
    - secretKey: SMTP_HOST
      remoteRef:
        key: testpilot/staging/smtp-host

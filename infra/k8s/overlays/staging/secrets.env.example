# Template only -- copy to `secrets.env` (gitignored, never committed) in
# this same directory and fill in real STAGING values before deploying.
# Same key set as overlays/production/secrets.env.example (both match
# base/config.yaml's Secret one-for-one -- see that file's own comment
# for why: each name is a Settings field env var) -- but the VALUES here
# must point at staging's own database/redis/storage, never production's.
# Reusing a production credential here would mean staging traffic (often
# less trusted -- test data, PR-preview deploys, wider team access) can
# read or write real production data.
#
# `secrets.env` is consumed by this overlay's kustomization.yaml via a
# `secretGenerator` with `behavior: replace` -- it REPLACES
# base/config.yaml's placeholder Secret entirely at render time
# (base/config.yaml itself is never edited). If `secrets.env` does not
# exist, `kubectl kustomize` / `kubectl apply -k` on this overlay will
# fail with a clear "file not found" error rather than silently deploying
# with REPLACE_ME_* placeholders -- a deliberate fail-closed default
# (SEC-004).
#
# Alternative: overlays/staging/external-secret.yaml.example -- the same
# External Secrets Operator opt-in pattern documented for production
# (infra/k8s/README.md's "External Secrets Operator (alternative)"
# section) works identically here. Only one of the two (this
# secretGenerator, or that ExternalSecret) may be active at a time --
# see that section for the switch-over steps.

# postgresql+asyncpg://testpilot_app:<password>@<host>:5432/<db> -- the
# least-privilege runtime role (RLS only applies to a non-superuser,
# non-table-owner connection -- see the rls_role_and_policies migration).
# Real value: staging's OWN managed Postgres instance, not production's
# (see infra/k8s/README.md's "What's deliberately NOT here").
DATABASE_URL=REPLACE_ME_STAGING_DATABASE_URL

# Needs DDL/role-management privileges DATABASE_URL's role deliberately
# does not have -- used only by the entrypoint's `alembic upgrade head`.
MIGRATIONS_DATABASE_URL=REPLACE_ME_STAGING_MIGRATIONS_DATABASE_URL

# Real value: staging's OWN managed Redis instance, not production's.
REDIS_URL=REPLACE_ME_STAGING_REDIS_URL

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be a different value than production's -- a shared signing key
# would let a staging-issued JWT authenticate against production.
JWT_SIGNING_KEY=REPLACE_ME_STAGING_JWT_SIGNING_KEY_MIN_32_CHARS

# Can be the same underlying AI provider account as production, or a
# separate lower-quota one -- your call; either way this repo doesn't
# invent a value.
AI_PROVIDER_API_KEY=REPLACE_ME_STAGING_AI_PROVIDER_API_KEY

# --- Object storage: the presigned-URL public-hostname problem ---
# Same requirement docs/RELEASE.md and quickstart-results.md document for
# production: storage/s3.py signs URLs using this same
# OBJECT_STORAGE_ENDPOINT_URL, and that signed URL is handed directly to
# a browser. If this value is a cluster-internal hostname, screenshot/
# artifact viewing will be broken for every real user outside the cluster
# network -- this MUST be a publicly-reachable S3/MinIO-compatible
# endpoint. Staging needs its OWN bucket/endpoint, separate from
# production's -- this overlay does not invent one, and does not assume
# staging reuses production's storage.
OBJECT_STORAGE_ENDPOINT_URL=REPLACE_ME_STAGING_PUBLIC_OBJECT_STORAGE_ENDPOINT_URL
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME_STAGING_OBJECT_STORAGE_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME_STAGING_OBJECT_STORAGE_SECRET_KEY

# Optional -- leave empty to disable (core/observability.py's init_sentry
# is a no-op with no DSN configured, per base/config.yaml's own comment).
# If used, prefer a separate Sentry project/environment tag from
# production so staging noise doesn't pollute production alerting.
SENTRY_DSN=

# Optional -- leave empty to fall back to log-only email delivery
# (core/email.py: `if settings.smtp_host is None: return`, after logging).
SMTP_HOST=REPLACE_ME_STAGING_SMTP_HOST

# Copy this file to .env in the same directory and fill in real values.
# Never commit a real .env file (see .gitignore).

ENVIRONMENT=local

# --- Database ---
# DATABASE_URL: the API/worker/CLI runtime connection. MUST be the
# least-privilege testpilot_app role (created by the RLS migration) — Row-
# Level Security never applies to a superuser or table owner, so connecting
# as POSTGRES_USER here would silently disable tenant isolation.
DATABASE_URL=postgresql+asyncpg://testpilot_app:${APP_DB_PASSWORD}@postgres:5432/testpilot
# MIGRATIONS_DATABASE_URL: used only by Alembic, which needs DDL/role-
# management privileges the app role deliberately does not have.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://testpilot:testpilot@postgres:5432/testpilot
POSTGRES_USER=testpilot
POSTGRES_PASSWORD=testpilot
POSTGRES_DB=testpilot
# Password for the testpilot_app role created by the RLS migration — read by
# that migration from this same env var at migration time.
APP_DB_PASSWORD=change-me-to-a-random-secret

# --- Redis (job queue, rate limiting, cache) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- AI provider (provider-agnostic; "fake" is used for local dev/CI without a real key) ---
AI_PROVIDER=fake
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=claude-sonnet-5

# --- Object storage (MinIO locally, S3-compatible in production) ---
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_BUCKET=testpilot-artifacts
OBJECT_STORAGE_ACCESS_KEY=testpilot
OBJECT_STORAGE_SECRET_KEY=testpilot123
OBJECT_STORAGE_REGION=us-east-1

# --- Observability (optional locally) ---
SENTRY_DSN=

# --- Transactional email (Mailhog locally; a real provider in production) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
EMAIL_FROM_ADDRESS=no-reply@testpilot.invalid

# --- Frontend origin allowed to call the API ---
# Not 3000: pick whatever port your local frontend actually runs on (this
# repo's frontend defaults to 3200 to avoid colliding with other projects'
# dev servers — see frontend/package.json).
CORS_ALLOWED_ORIGINS=["http://localhost:3200"]

# --- Data retention ---
ARTIFACT_RETENTION_DAYS=90

# --- Frontend-only (read by Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
